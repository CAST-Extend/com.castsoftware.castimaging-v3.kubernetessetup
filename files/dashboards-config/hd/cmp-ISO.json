            "title": "Reliability \r(ISO-5055)",
            "widget": "gauge",
            "industryStandard": {
              "id": "1061003",
              "indexID": "1061000",
              "mode": "compliance",
              "format": "0.0%",
              "description": "compliance"
            }
          }
        },
